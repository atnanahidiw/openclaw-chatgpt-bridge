PORT=8080
REQUEST_TIMEOUT_MS=30000
MAX_BODY_BYTES=1048576

# OpenClaw endpoint reachable from this container.
# Use a tailnet hostname/IP if OpenClaw is private.
#
# Direct to the OpenClaw port:
OPENCLAW_WEBHOOK_URL=http://openclaw-gateway:18789/plugins/webhooks/gpt
#
# Behind `tailscale serve`, OpenClaw is fronted on HTTPS port 443 instead, so
# the URL is https with no port. The container then needs ca-certificates
# (the Dockerfile installs it) to verify the *.ts.net certificate:
# OPENCLAW_WEBHOOK_URL=https://your-host.your-tailnet.ts.net/plugins/webhooks/gpt

# Shared secret used by OpenClaw webhook route.
OPENCLAW_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Recorded in bridge logs only. NOT sent to OpenClaw: the webhook route is
# bound to a session by OpenClaw config, so the caller cannot choose one.
OPENCLAW_SESSION_KEY=agent:main:chatgpt

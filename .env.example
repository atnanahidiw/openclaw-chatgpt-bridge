# The listener binds ADDR. PORT is read but NOT used for binding, so changing
# PORT alone moves nothing. Use :8080 to listen on all interfaces, or
# 127.0.0.1:8080 when a proxy such as Caddy sits in front.
ADDR=:8080
PORT=8080
REQUEST_TIMEOUT_MS=30000
MAX_BODY_BYTES=1048576

# OpenClaw endpoint reachable from this container.
# Use a tailnet hostname/IP if OpenClaw is private.
#
# Direct to the OpenClaw port:
OPENCLAW_WEBHOOK_URL=http://openclaw-gateway:18789/plugins/webhooks/gpt
#
# Behind `tailscale serve`, OpenClaw is fronted on HTTPS port 443 instead, so
# the URL is https with no port. The container then needs ca-certificates
# (the Dockerfile installs it) to verify the *.ts.net certificate:
# OPENCLAW_WEBHOOK_URL=https://your-host.your-tailnet.ts.net/plugins/webhooks/gpt

# Shared secret used by OpenClaw webhook route.
OPENCLAW_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Recorded in bridge logs only. NOT sent to OpenClaw: the webhook route is
# bound to a session by OpenClaw config, so the caller cannot choose one.
OPENCLAW_SESSION_KEY=agent:main:chatgpt

# Shared secret the CALLER (your Custom GPT) must present to the bridge.
# Without it, anyone who knows the bridge URL can drive OpenClaw TaskFlows.
# Sent by the Custom GPT as an `api_key` header. The bridge also accepts
# `Authorization: Bearer <key>` for curl.
BRIDGE_API_KEY=replace-with-a-long-random-secret

# Tailscale auth key for the CLOUD sidecar that carries the bridge onto your
# tailnet. The bridge binary never reads this — it is a deployment input only,
# consumed by the tailscale container next to it.
#
# Generate at https://login.tailscale.com/admin/settings/keys with BOTH:
#   Ephemeral  - the device removes itself when the app scales to zero
#   Reusable   - the app can start more than once
#
# This is a DIFFERENT device from the machine running OpenClaw. Do not reuse
# that machine's key here.
TS_AUTHKEY=tskey-auth-REPLACE-WITH-YOUR-EPHEMERAL-REUSABLE-KEY

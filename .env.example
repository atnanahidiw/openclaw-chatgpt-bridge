# Local development config. Copy to .env and fill in.
# .env is gitignored - never commit it.

# The listener binds ADDR. PORT is read but NOT used for binding, so changing
# PORT alone moves nothing. Use :8080 to listen on all interfaces, or
# 127.0.0.1:8080 when a proxy such as Caddy sits in front.
ADDR=:8080
PORT=8080

# How long a synchronous `ask` may take. A turn that runs commands or edits
# files is slow; use ask_async for anything substantial.
REQUEST_TIMEOUT_MS=120000

# How long an async turn may run before it is abandoned.
ASYNC_TIMEOUT_MS=900000

# How long a finished async job stays readable by get_result.
JOB_TTL_MS=3600000

MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# OpenClaw Gateway
# ---------------------------------------------------------------------------

# Base URL of the OpenClaw Gateway. The bridge appends /v1/chat/completions.
# Behind `tailscale serve` this is https with no port - check with:
#   tailscale serve status
OPENCLAW_GATEWAY_URL=https://your-host.your-tailnet.ts.net

# Gateway token, from gateway.auth.token in ~/.openclaw/openclaw.json.
#
# WARNING: this is full operator access to OpenClaw. Anyone holding it can run
# an agent turn with owner permissions - shell commands, file edits, the lot.
# It never leaves the bridge; callers authenticate with BRIDGE_API_KEY instead.
OPENCLAW_GATEWAY_TOKEN=replace-with-gateway-auth-token

# Which agent to target. See GET /v1/models on the gateway for valid ids.
OPENCLAW_AGENT=openclaw/default

# OpenClaw session the work runs in. A dedicated session keeps ChatGPT's work
# separate from your day-to-day conversation. Reserved namespaces are rejected:
# subagent:, cron:, acp:
OPENCLAW_SESSION_KEY=agent:main:chatgpt

# ---------------------------------------------------------------------------
# Bridge access
# ---------------------------------------------------------------------------

# Secret the CALLER (your Custom GPT, or curl) must present to the bridge.
# Sent as an `api_key` header; `Authorization: Bearer <key>` also works.
#
# Leave it unset and the bridge starts anyway, logs a warning, and accepts
# unauthenticated requests from anyone who finds the URL. Generate one with:
#   openssl rand -hex 32
BRIDGE_API_KEY=replace-with-a-long-random-secret

# ---------------------------------------------------------------------------
# Tailscale sidecar (cloud deployments only)
# ---------------------------------------------------------------------------

# Set true when a tailscale sidecar carries the bridge onto your tailnet.
TAILSCALE_ENABLED=false
TAILSCALE_PROXY_ADDR=127.0.0.1:1055

# Auth key for that sidecar. The bridge binary never reads this - it is a
# deployment input consumed by the tailscale container beside it.
#
# Generate at https://login.tailscale.com/admin/settings/keys with BOTH
# Ephemeral and Reusable enabled. This is a DIFFERENT device from the machine
# running OpenClaw; do not reuse that machine's key.
TS_AUTHKEY=tskey-auth-REPLACE-WITH-YOUR-EPHEMERAL-REUSABLE-KEY
